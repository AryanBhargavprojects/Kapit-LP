---
---
<section>
  <div class="max-w-4xl mx-auto px-6 pt-36 pb-20 w-full flex flex-col items-center text-center">

    <!-- Eyebrow -->
    <span class="text-xs uppercase tracking-[0.2em] text-[#8B8B8B] mb-8" style="font-family: 'JetBrains Mono', monospace;">
      UNIFIED FINANCIAL DATA API
    </span>

    <!-- Headline -->
    <h1 class="text-6xl lg:text-7xl xl:text-8xl font-bold tracking-tight leading-[1.0] text-[#EDEDED] mb-6" style="font-family: Inter, sans-serif;">
      Financial data,<br>built for agents.
    </h1>

    <!-- Subtitle -->
    <p class="text-lg text-[#ADADAD] max-w-2xl mx-auto leading-relaxed mb-12">
      Stocks, crypto, and Polymarket through one base URL, one API key, and one response envelope your agent can parse.
    </p>

    <!-- Copy bar section -->
    <div class="w-full max-w-2xl mx-auto mb-8">
      <p class="text-xs uppercase tracking-widest text-[#8B8B8B] mb-3" style="font-family: 'JetBrains Mono', monospace;">
        Drop into your AI coding agent to get started
      </p>

      <div class="flex items-center justify-between border border-[#2A2A2A] bg-[#060606]/80 rounded-xl px-6 py-4" style="backdrop-filter: blur(8px);">
        <div class="flex items-center gap-3 min-w-0">
          <span class="text-[#6E6E6E] text-sm flex-shrink-0" style="font-family: 'JetBrains Mono', monospace;">$</span>
          <span class="text-[#EDEDED] text-sm truncate" style="font-family: 'JetBrains Mono', monospace;">npx skills add https://github.com/AryanBhargavprojects/Kapit-skills.git</span>
        </div>
        <button
          id="copy-llms"
          class="ml-4 flex-shrink-0 text-xs text-[#8B8B8B] hover:text-[#EDEDED] border border-[#2A2A2A] rounded-lg px-3 py-1.5 transition-colors"
          style="font-family: 'JetBrains Mono', monospace;"
          aria-label="Copy curl command"
        >
          Copy
        </button>
      </div>

      <p class="text-xs text-[#6E6E6E] italic mt-2">
        Your agent will discover every endpoint, schema, and example automatically.
      </p>
    </div>

    <!-- Secondary CTAs -->
    <div class="flex items-center justify-center gap-6 mt-4">
      <a
        href="/signup"
        class="inline-flex items-center text-sm text-[#EDEDED] border border-[#3A3A3A] rounded-full px-6 py-2.5 hover:border-[#5A5A5A] transition-colors"
      >
        Get your API key
      </a>
      <a
        href="/docs"
        class="text-sm text-[#8B8B8B] hover:text-[#EDEDED] transition-colors"
      >
        Read the docs →
      </a>
    </div>

  </div>
</section>

<script>
  const btn = document.getElementById('copy-llms');
  if (btn) {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText('npx skills add https://github.com/AryanBhargavprojects/Kapit-skills.git');
      btn.textContent = 'Copied!';
      btn.classList.add('text-white');
      btn.classList.remove('text-[#8B8B8B]', 'hover:text-[#EDEDED]');
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.classList.remove('text-white');
        btn.classList.add('text-[#8B8B8B]', 'hover:text-[#EDEDED]');
      }, 2000);
    });
  }
</script>
