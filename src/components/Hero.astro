---
---
<section class="min-h-[calc(100vh-56px)] flex items-center pt-14 border-b border-[#262626]">
  <div class="max-w-6xl mx-auto px-6 py-20 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left -->
      <div class="flex flex-col gap-6">
        <span class="text-xs text-[#00D26A] uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace;">v1 · stocks · crypto · prediction markets</span>

        <h1 class="text-5xl lg:text-6xl font-bold text-[#EDEDED] leading-[1.08] tracking-tight" style="font-family: Inter, sans-serif;">
          Financial data,<br>built for agents.
        </h1>

        <p class="text-lg text-[#A1A1A1] leading-relaxed max-w-md">
          Stocks, crypto, and Polymarket through one base URL, one API key, and one response envelope your agent can parse.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/signup" class="inline-flex items-center gap-2 bg-[#00D26A] text-[#0A0A0A] font-semibold text-sm px-5 py-2.5 rounded-lg hover:bg-[#00e87a] transition-colors">
            Get your API key
          </a>
          <a href="/docs" class="text-[#A1A1A1] text-sm hover:text-[#EDEDED] transition-colors">Read the docs →</a>
        </div>

        <div class="flex items-center gap-3 mt-1">
          <div class="flex items-center gap-2 bg-[#141414] border border-[#262626] rounded-lg px-3 py-2 overflow-x-auto max-w-full">
            <code class="text-xs text-[#A1A1A1] whitespace-nowrap" style="font-family: 'JetBrains Mono', monospace;">
              curl https://api.kapit.dev/v1/stocks/quotes/AAPL \<br class="hidden"/>
              <span class="ml-4">-H "Authorization: Bearer $KAPIT_KEY"</span>
            </code>
            <button
              id="copy-curl"
              class="ml-2 flex-shrink-0 text-[#6E6E6E] hover:text-[#A1A1A1] transition-colors"
              aria-label="Copy curl command"
            >
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right: Code block -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl overflow-hidden" style="box-shadow: 0 1px 0 rgba(255,255,255,0.04);">
        <!-- Status bar -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-[#262626]">
          <span class="w-2 h-2 rounded-full bg-[#00D26A] flex-shrink-0" style="box-shadow: 0 0 6px #00D26A66;"></span>
          <span class="text-xs text-[#6E6E6E]" style="font-family: 'JetBrains Mono', monospace;">api.kapit.dev · live</span>
        </div>
        <!-- Code content -->
        <div class="overflow-x-auto">
          <pre class="p-5 text-xs leading-relaxed" style="font-family: 'JetBrains Mono', monospace;"><code><span class="text-[#6E6E6E]">$ </span><span class="text-[#EDEDED]">curl https://api.kapit.dev/v1/stocks/quotes/AAPL \</span>
<span class="text-[#EDEDED]">    -H </span><span class="text-[#EDEDED]">"Authorization: Bearer $KAPIT_KEY"</span>

<span class="text-[#6E6E6E]">{</span>
  <span class="text-[#6E6E6E]">"data"</span><span class="text-[#6E6E6E]">: {</span>
    <span class="text-[#A1A1A1]">"symbol"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#EDEDED]">"AAPL"</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"price"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">213.49</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"change_percent"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">0.87</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"volume"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">42819300</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"market_cap"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">3241000000000</span>
  <span class="text-[#6E6E6E]">},</span>
  <span class="text-[#6E6E6E]">"meta"</span><span class="text-[#6E6E6E]">: {</span>
    <span class="text-[#A1A1A1]">"source"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"provider"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#00D26A]">"fmp"</span><span class="text-[#6E6E6E]">,</span>
      <span class="text-[#A1A1A1]">"fallback_used"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#F7B500]">false</span>
    <span class="text-[#6E6E6E]">},</span>
    <span class="text-[#A1A1A1]">"freshness"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"as_of"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#EDEDED]">"2026-05-15T14:32:01Z"</span><span class="text-[#6E6E6E]">,</span>
      <span class="text-[#A1A1A1]">"cache_ttl_seconds"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">60</span>
    <span class="text-[#6E6E6E]">},</span>
    <span class="text-[#A1A1A1]">"rate_limit"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"remaining"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">987</span>
    <span class="text-[#6E6E6E]">}</span>
  <span class="text-[#6E6E6E]">}</span>
<span class="text-[#6E6E6E]">}</span></code></pre>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-curl');
  btn?.addEventListener('click', () => {
    navigator.clipboard.writeText('curl https://api.kapit.dev/v1/stocks/quotes/AAPL \\\n    -H "Authorization: Bearer $KAPIT_KEY"');
    btn.innerHTML = '<svg width="14" height="14" fill="none" stroke="#00D26A" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>';
    setTimeout(() => {
      btn.innerHTML = '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    }, 1500);
  });
</script>
