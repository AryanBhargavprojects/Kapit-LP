---
---
<section class="py-32 border-b border-[#262626]">
  <div class="max-w-6xl mx-auto px-6">

    <div class="mb-12">
      <span class="inline-flex items-center text-xs uppercase tracking-widest text-[#6E6E6E] border border-[#262626] rounded-full px-3 py-1 mb-6" style="font-family: 'JetBrains Mono', monospace;">Agent-Native</span>
      <h2 class="text-3xl lg:text-5xl font-bold text-[#EDEDED] mb-4 tracking-tight" style="font-family: Inter, sans-serif;">
        Built for agents, not just for humans.
      </h2>
      <p class="text-[#A1A1A1] text-lg max-w-xl">
        Every response is structured, recoverable, and self-describing. Your agent never has to guess.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-5">

      <!-- Card 1: Structured recoverable errors -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl p-7 flex flex-col gap-4 hover:border-[#3A3A3A] transition-colors duration-200" style="box-shadow: 0 1px 0 rgba(255,255,255,0.04);">
        <div class="mb-1 text-[#7C3AED]">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h3 class="text-[#EDEDED] font-semibold text-base mb-1" style="font-family: Inter, sans-serif;">Structured recoverable errors</h3>
          <p class="text-[#6E6E6E] text-xs leading-relaxed">Every error tells your agent exactly how to recover. No string-matching on error messages.</p>
        </div>
        <pre class="bg-[#0A0A0A] border border-[#262626] rounded-lg p-3 text-xs overflow-x-auto flex-1" style="font-family: 'JetBrains Mono', monospace;"><code><span class="text-[#6E6E6E]">{</span>
  <span class="text-[#A1A1A1]">"error"</span><span class="text-[#6E6E6E]">: {</span>
    <span class="text-[#A1A1A1]">"code"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#EDEDED]">"upstream_rate_limited"</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"is_retriable"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#F7B500]">true</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"retry_after_seconds"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">30</span><span class="text-[#6E6E6E]">,</span>
    <span class="text-[#A1A1A1]">"recovery"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"action"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C3AED]">"retry_after"</span><span class="text-[#6E6E6E]">,</span>
      <span class="text-[#A1A1A1]">"instructions"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#EDEDED]">"Wait 30s then retry."</span>
    <span class="text-[#6E6E6E]">}</span>
  <span class="text-[#6E6E6E]">}</span>
<span class="text-[#6E6E6E]">}</span></code></pre>
      </div>

      <!-- Card 2: Provider metadata -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl p-7 flex flex-col gap-4 hover:border-[#3A3A3A] transition-colors duration-200" style="box-shadow: 0 1px 0 rgba(255,255,255,0.04);">
        <div class="mb-1 text-[#7C3AED]">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z"/>
            <path d="M9 12h6M9 8h6M9 16h4" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h3 class="text-[#EDEDED] font-semibold text-base mb-1" style="font-family: Inter, sans-serif;">Provider metadata in every response</h3>
          <p class="text-[#6E6E6E] text-xs leading-relaxed">Know where data came from, when it was fetched, and whether a fallback kicked in.</p>
        </div>
        <pre class="bg-[#0A0A0A] border border-[#262626] rounded-lg p-3 text-xs overflow-x-auto flex-1" style="font-family: 'JetBrains Mono', monospace;"><code><span class="text-[#6E6E6E]">{</span>
  <span class="text-[#A1A1A1]">"meta"</span><span class="text-[#6E6E6E]">: {</span>
    <span class="text-[#A1A1A1]">"source"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"provider"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C3AED]">"fmp"</span><span class="text-[#6E6E6E]">,</span>
      <span class="text-[#A1A1A1]">"fallback_used"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#F7B500]">false</span>
    <span class="text-[#6E6E6E]">},</span>
    <span class="text-[#A1A1A1]">"freshness"</span><span class="text-[#6E6E6E]">: {</span>
      <span class="text-[#A1A1A1]">"as_of"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#EDEDED]">"2026-05-15T14:32:01Z"</span><span class="text-[#6E6E6E]">,</span>
      <span class="text-[#A1A1A1]">"cache_ttl_seconds"</span><span class="text-[#6E6E6E]">: </span><span class="text-[#7C9EFF]">60</span>
    <span class="text-[#6E6E6E]">}</span>
  <span class="text-[#6E6E6E]">}</span>
<span class="text-[#6E6E6E]">}</span></code></pre>
      </div>

      <!-- Card 3: Self-discoverable -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl p-7 flex flex-col gap-4 hover:border-[#3A3A3A] transition-colors duration-200" style="box-shadow: 0 1px 0 rgba(255,255,255,0.04);">
        <div class="mb-1 text-[#7C3AED]">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h3 class="text-[#EDEDED] font-semibold text-base mb-1" style="font-family: Inter, sans-serif;">Self-discoverable for agents</h3>
          <p class="text-[#6E6E6E] text-xs leading-relaxed">Drop your agent at api.kapit.dev — it discovers every endpoint, schema, and example on its own.</p>
        </div>
        <pre class="bg-[#0A0A0A] border border-[#262626] rounded-lg p-3 text-xs overflow-x-auto flex-1" style="font-family: 'JetBrains Mono', monospace;"><code><span class="text-[#7C3AED]">GET</span> <span class="text-[#EDEDED]">/v1/stocks/quotes/{"{symbol}"}</span>
<span class="text-[#6E6E6E]"># Returns real-time stock quote.</span>
<span class="text-[#6E6E6E]"># symbol: ticker (e.g. AAPL)</span>

<span class="text-[#7C3AED]">GET</span> <span class="text-[#EDEDED]">/v1/crypto/prices/{"{symbol}"}</span>
<span class="text-[#6E6E6E]"># symbol: CoinGecko ID (e.g. bitcoin)</span>

<span class="text-[#A1A1A1]">&gt; GET /llms.txt for full manifest</span></code></pre>
      </div>

    </div>
  </div>
</section>
