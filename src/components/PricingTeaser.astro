---
---
<section class="py-24 border-b border-[#262626]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-[#EDEDED] tracking-tight mb-3">
        Free to start. Pay when you scale.
      </h2>
      <p class="text-[#A1A1A1] text-lg">
        1,000 requests/month free, no credit card required.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Free tier -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl p-6 flex flex-col gap-5">
        <div>
          <span class="inline-block text-xs font-mono uppercase tracking-wider text-[#A1A1A1] bg-[#1C1C1C] border border-[#262626] rounded px-2 py-0.5 mb-4">Free</span>
          <p class="text-3xl font-bold text-[#EDEDED] font-mono">$0<span class="text-base font-normal text-[#6E6E6E]"> / month</span></p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-[#A1A1A1]">
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            1,000 requests/month
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Stocks, crypto, Polymarket
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Test API key
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Community support
          </li>
        </ul>
        <div class="mt-auto pt-2">
          <a href="/signup" class="text-sm text-[#00D26A] hover:text-[#00e87a] transition-colors">
            Get started free →
          </a>
        </div>
      </div>

      <!-- Pro tier (highlighted) -->
      <div class="bg-[#141414] border border-[#00D26A] rounded-xl p-6 flex flex-col gap-5 relative">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-block text-xs font-mono uppercase tracking-wider text-[#00D26A] bg-[#00D26A]/10 border border-[#00D26A]/30 rounded px-2 py-0.5">Pro</span>
            <span class="inline-block text-xs font-mono text-[#6E6E6E] bg-[#1C1C1C] border border-[#262626] rounded px-2 py-0.5">Most popular</span>
          </div>
          <p class="text-3xl font-bold text-[#EDEDED] font-mono">$29<span class="text-base font-normal text-[#6E6E6E]"> / month</span></p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-[#A1A1A1]">
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            100,000 requests/month
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Live API keys
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Priority support
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Rate limit metadata
          </li>
        </ul>
        <div class="mt-auto pt-2">
          <a
            href="/signup?plan=pro"
            class="inline-flex items-center justify-center w-full bg-[#00D26A] text-[#0A0A0A] font-semibold text-sm px-5 py-2.5 rounded-lg hover:bg-[#00e87a] transition-colors"
          >
            Start Pro →
          </a>
        </div>
      </div>

      <!-- Scale tier -->
      <div class="bg-[#141414] border border-[#262626] rounded-xl p-6 flex flex-col gap-5">
        <div>
          <span class="inline-block text-xs font-mono uppercase tracking-wider text-[#A1A1A1] bg-[#1C1C1C] border border-[#262626] rounded px-2 py-0.5 mb-4">Scale</span>
          <p class="text-3xl font-bold text-[#EDEDED] font-mono">Custom</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm text-[#A1A1A1]">
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Unlimited requests
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            SLA
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Dedicated support
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#00D26A] mt-0.5">✓</span>
            Custom rate limits
          </li>
        </ul>
        <div class="mt-auto pt-2">
          <a href="/contact" class="text-sm text-[#00D26A] hover:text-[#00e87a] transition-colors">
            Contact us →
          </a>
        </div>
      </div>
    </div>

    <div class="text-center mt-8">
      <a href="/pricing" class="text-sm text-[#A1A1A1] hover:text-[#EDEDED] transition-colors">
        See full pricing →
      </a>
    </div>
  </div>
</section>
