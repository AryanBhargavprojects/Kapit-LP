---
---
<section class="py-24 border-b border-[#111111]">
  <div class="max-w-5xl mx-auto px-6">

    <p class="text-center text-xs uppercase tracking-[0.25em] text-[#8B8B8B] mb-16" style="font-family: 'JetBrains Mono', monospace;">
      WORKS WITH
    </p>

    <!-- Row 1: Claude Code, Codex, OpenClaw, PI -->
    <div class="flex justify-center items-center gap-20 mb-14 flex-wrap">
      <img
        src="/agent-logos/claudecode-text.svg"
        alt="Claude Code"
        style="height: 40px; width: auto; filter: brightness(0) invert(1);"
      />
      <img
        src="/agent-logos/codex-text.svg"
        alt="Codex"
        style="height: 40px; width: auto; filter: brightness(0) invert(1);"
      />
      <img
        src="/agent-logos/openclaw-wordmark-dark.svg"
        alt="OpenClaw"
        style="height: 40px; width: auto;"
      />
      <img
        src="/agent-logos/pi-coding-agent.svg"
        alt="Pi Coding Agent"
        style="height: 52px; width: auto;"
      />
    </div>

    <!-- Row 2: Kilo Code, Hermes, Opencode -->
    <div class="flex justify-center items-center gap-20 flex-wrap">
      <img
        src="/agent-logos/kilocode.svg"
        alt="Kilo Code"
        style="height: 40px; width: auto; filter: brightness(0) invert(1);"
      />
      <div class="flex items-center gap-3 flex-shrink-0">
        <img
          src="/agent-logos/mascot_goes_with_text.webp"
          alt="Hermes Agent"
          style="height: 40px; width: auto;"
        />
        <img
          src="/agent-logos/hermesagent-text.svg"
          alt=""
          style="height: 18px; width: auto; filter: brightness(0) invert(1);"
        />
      </div>
      <img
        src="/agent-logos/opencode-wordmark-dark.svg"
        alt="Opencode"
        style="height: 40px; width: auto;"
      />
    </div>

  </div>
</section>
