---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AgentNativeDifference from '../components/AgentNativeDifference.astro';
import AssetClasses from '../components/AssetClasses.astro';
import TryItLive from '../components/TryItLive';
import CodeExamples from '../components/CodeExamples.astro';
import BuiltForAgents from '../components/BuiltForAgents.astro';
import PricingTeaser from '../components/PricingTeaser.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <TrustStrip />
    <AgentNativeDifference />
    <AssetClasses />
    <TryItLive client:load />
    <CodeExamples />
    <BuiltForAgents />
    <PricingTeaser />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
