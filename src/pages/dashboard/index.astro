---
export const prerender = false;

import '../../styles/global.css';
import NavbarAuthActions from '../../components/NavbarAuthActions.tsx';
import ApiKeysCard from '../../components/dashboard/ApiKeysCard.tsx';
import UsageCard from '../../components/dashboard/UsageCard.tsx';
import UpgradeCard from '../../components/dashboard/UpgradeCard.tsx';
import { clerkClient } from '@clerk/astro/server';

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect('/');

const user = await clerkClient(Astro).users.getUser(userId);
const displayName = user.firstName || user.username || 'there';
const email = user.emailAddresses[0]?.emailAddress;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Dashboard — Kapit</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#0A0A0A] text-[#EDEDED] antialiased">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#0A0A0A] border-b border-[#262626] h-16">
      <div class="max-w-5xl mx-auto px-6 h-full flex items-center justify-between">
        <a href="/">
          <img src="/kapit_logo.png" alt="Kapit" class="h-12 w-auto" />
        </a>
        <div class="flex items-center gap-6">
          <a href="/docs" class="text-sm text-[#A1A1A1] hover:text-[#EDEDED] transition-colors">Docs</a>
          <NavbarAuthActions client:load />
        </div>
      </div>
    </nav>

    <!-- Main content -->
    <main class="max-w-5xl mx-auto px-6 pt-24 pb-16">
      <!-- Welcome (server-rendered) -->
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-[#EDEDED]">Welcome back, {displayName}</h1>
        {email && <p class="text-[#6E6E6E] mt-1 text-sm">{email}</p>}
      </div>

      <!-- Cards -->
      <div class="flex flex-col gap-6">
        <ApiKeysCard client:load />
        <UsageCard client:load />
        <UpgradeCard client:load />
      </div>
    </main>
  </body>
</html>
